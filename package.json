{
  "name": "flowlee-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run css:build && bun --hot src/index.ts",
    "css:dev": "bunx @tailwindcss/cli -i src/styles/index.css -o src/styles/output.css --watch",
    "css:build": "bunx @tailwindcss/cli -i src/styles/index.css -o src/styles/output.css --minify",
    "build": "bun run css:build && bun build ./src/index.html --outdir=dist --sourcemap --target=browser --minify --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*'",
    "start": "NODE_ENV=production bun src/index.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix src/",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "type-check": "tsc --noEmit",
    "prepare": "husky",
   "build:css": "npx @tailwindcss/cli -i ./src/styles/index.css -o ./src/styles/output.css"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,json,css}": "prettier --write",
    "src/**/*.{ts,tsx}": "eslint --fix"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "latest",
    "@commitlint/config-conventional": "latest",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.3.1",
    "@types/bun": "latest",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "daisyui": "^5.5.23",
    "eslint": "^10.5.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "latest",
    "globals": "^17.6.0",
    "husky": "latest",
    "lint-staged": "latest",
    "prettier": "latest",
    "prettier-plugin-tailwindcss": "latest",
    "typescript-eslint": "^8.61.1"
  }
}
